"""Exact local smoke carrier. Never invokes SSH, a shell, or another host."""

import os
from pathlib import Path
import shlex
import stat
import sys


def refuse():
    print("minimal smoke SSH fixture: refused unexpected invocation", file=sys.stderr)
    raise SystemExit(2)


root = Path(__file__).resolve().parents[2]
binary = root / "unmoor"
arguments = sys.argv[1:]
if len(arguments) != 3 or arguments[:2] != ["--", "minimal-smoke.invalid"]:
    refuse()
try:
    work = Path(os.environ["MINIMAL_SMOKE_DIR"])
    parent = work / "deaddrop"
    for directory in (work, parent):
        info = directory.lstat()
        if (directory != directory.resolve() or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700):
            refuse()
    if not work.name.startswith("unmoor-smoke-"):
        refuse()
    tokens = shlex.split(arguments[2])
except (KeyError, OSError, ValueError):
    refuse()

environment = os.environ.copy()
if tokens == [str(binary), "version", "--pq-probe"]:
    phase = "pq-probe"
    command = tokens
else:
    # These are the only optional environment assignment and generated listen
    # command accepted. shlex tokenization is never followed by shell parsing.
    if tokens[:1] == ["UNMOOR_PACE_BPS=400000"]:
        tokens = tokens[1:]
        environment["UNMOOR_PACE_BPS"] = "400000"
    expected = ["exec", str(binary), "listen", "--deaddrop-bootstrap",
                "--timeout", "20", "--bind-host", "127.0.0.1",
                "--bootstrap-foreground", "--pq-carrier=require"]
    if tokens != expected:
        refuse()
    phase = "listen"
    command = tokens[1:] + ["--deaddrop-parent", str(parent)]
    environment["SHELL"] = str(root / "tests/fixtures/finite-shell")

# Record only public control-flow labels, never carrier bytes or key material.
fd = os.open(work / "ssh.calls", os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
with os.fdopen(fd, "w") as stream:
    stream.write(phase + "\n")
os.execve(binary, command, environment)
