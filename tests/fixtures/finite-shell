"""Finite stand-in for the shell inside the real product-created PTY."""

import os
import sys

if len(sys.argv) != 1 or os.environ.get("UNMOOR_SESSION") != "1" or not all(os.isatty(fd) for fd in (0, 1, 2)):
    raise SystemExit(125)
os.write(1, b"UNMOOR_MINIMAL_PTY_OK\n")
